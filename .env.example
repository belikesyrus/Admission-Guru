# ── Admission Guru — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# Flask secret key for JWT token signing.
# Change this to a long, random string in any non-local environment.
SECRET_KEY=your_secret_key_here

# Port the Flask dev server listens on (default: 5000)
PORT=5000

# Set to "production" when deploying (disables debug mode)
FLASK_ENV=development
